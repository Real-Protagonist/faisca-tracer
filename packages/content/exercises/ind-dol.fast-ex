    "objectives": [
      {
        "id": "hold",
        "text": {
          "key": "exercise.ind-dol.obj.hold"
        },
        "rule": {
          "type": "state",
          "device": "M1",
          "is": "running"
        },
        "given": [
          {
            "press": "S1",
            "hold": 0.3
          },
          {
            "run": 3
          }
        ]
      },
      {
        "id": "stop",
        "text": {
          "key": "exercise.ind-dol.obj.stop"
        },
        "rule": {
          "type": "then",
          "first": {
            "type": "state",
            "device": "M1",
            "is": "running"
          },
          "steps": [
            {
              "press": "S0",
              "hold": 0.3
            },
            {
              "run": 6
            }
          ],
          "rule": {
            "type": "not",
            "rule": {
              "type": "state",
              "device": "M1",
              "is": "running"
            }
          }
        },
        "given": [
          {
            "press": "S1",
            "hold": 0.3
          },
          {
            "run": 3
          }
        ]
      },
