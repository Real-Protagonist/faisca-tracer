              "is": "running"
            }
          }
        },
        "given": [
          {
            "press": "S1",
            "hold": 0.3
          },
          {
            "run": 3
          }
        ]
      },
      {
        "id": "clean",
        "text": {
          "key": "exercise.ind-dol.obj.clean"
        },
        "rule": {
          "type": "noDiag"
        }
      }
    ],
