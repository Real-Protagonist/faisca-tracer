          "key": "exercise.ind-dol.obj.relay"
        },
        "rule": {
          "type": "then",
          "first": {
            "type": "state",
            "device": "M1",
            "is": "running"
          },
          "steps": [
            {
              "op": "F1",
              "action": "test"
            },
